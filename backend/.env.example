# Local dev needs no .env at all — app/core/config.py defaults match docker-compose.yml.
# Copy to .env only to override.

# Accepts postgres:// or postgresql:// too; config.py rewrites the scheme to asyncpg.
DATABASE_URL=postgresql+asyncpg://ptb:ptb@localhost:5432/ptb

# Signs the session cookie 
SESSION_SECRET=dev-secret

# Guards POST /api/admin/sync
ADMIN_SECRET=dev-admin-secret

# PokeAPI sync runs daily at this hour, US Eastern
SYNC_HOUR=4
SYNC_TIMEZONE=America/New_York
